    {
      "title": "Login Rate (por minuto)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Elasticsearch",
      "targets": [
        {
          "query": "message:\"LOGIN_SUCCESS\" OR message:\"login\"",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "field": "@timestamp",
              "id": "2",
              "settings": { "interval": "1m" }
            }
          ]
        }
      ]
    },
