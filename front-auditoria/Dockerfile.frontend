# Build stage
FROM node:18-alpine AS build

WORKDIR /app

ARG CONFIGURATION=production

# Copiar arquivos de configuração
COPY package*.json ./

# Instalar dependências (incluindo dev dependencies para o build)
RUN npm ci

# Copiar código fonte
COPY . .

# Build da aplicação com a configuração especificada
ARG BASE_HREF=/
RUN npm run build -- --configuration=${CONFIGURATION} --base-href=${BASE_HREF}

# Production stage
FROM nginx:alpine

# Copiar arquivos build para nginx
COPY --from=build /app/dist/front-auditoria/browser /usr/share/nginx/html

# Copiar configuração customizada do nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Expor porta
EXPOSE 4200

# Comando para iniciar nginx
CMD ["nginx", "-g", "daemon off;"]
